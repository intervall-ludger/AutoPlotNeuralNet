\ProvidesPackage{Ball}[2026/06/04 v0.1 apnn sum/concat ball]
\usetikzlibrary{3d}

\pgfkeys{
    /ball/.is family, /ball,
    default/.style={
        name=ball, fill=green, opacity=0.85, radius=0.5, logo={$+$},
    },
    name/.store in=\ballname,
    fill/.store in=\ballfill,
    opacity/.store in=\ballopacity,
    radius/.store in=\ballradius,
    logo/.store in=\balllogo,
}

\tikzset{Ball/.pic={
    \pgfkeys{/ball/.cd, default, #1}
    \pgfmathsetmacro{\r}{\ballradius}

    \shade[ball color=\ballfill, opacity=\ballopacity] (\r,0) circle [radius=\r];
    \draw[draw=black!55, line width=0.3pt] (\r,0) circle [radius=\r];
    \node[font=\fntmd] at (\r,0) {\balllogo};

    \pgfmathsetmacro{\rd}{\r*0.70710678}
    \coordinate (\ballname-west)      at (0     , 0  );
    \coordinate (\ballname-east)      at (2*\r   , 0  );
    \coordinate (\ballname-north)     at (\r     , \r );
    \coordinate (\ballname-south)     at (\r     ,-\r );
    \coordinate (\ballname-anchor)    at (\r     , 0  );
    % diagonal + near anchors for parity with Box / RightBandedBox
    \coordinate (\ballname-northeast) at (\r+\rd , \rd);
    \coordinate (\ballname-northwest) at (\r-\rd , \rd);
    \coordinate (\ballname-southeast) at (\r+\rd ,-\rd);
    \coordinate (\ballname-southwest) at (\r-\rd ,-\rd);
    \coordinate (\ballname-near)      at (\r     , 0  );
    \coordinate (\ballname-neareast)  at (2*\r   , 0  );
    \coordinate (\ballname-nearwest)  at (0      , 0  );
}}
