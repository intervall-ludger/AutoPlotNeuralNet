\ProvidesPackage{Box}[2026/06/04 v0.1 apnn 3D box]
\usetikzlibrary{3d}

\pgfkeys{
    /boxblock/.is family, /boxblock,
    default/.style={
        name=box, fill=white, opacity=0.7,
        height=10, width=2, depth=10, scale=0.2,
        caption={}, xlabel={}, ylabel={}, zlabel={},
    },
    name/.store in=\boxname,
    fill/.store in=\boxfill,
    opacity/.store in=\boxopacity,
    height/.store in=\boxheight,
    width/.store in=\boxwidth,
    depth/.store in=\boxdepth,
    scale/.store in=\boxscale,
    caption/.store in=\boxcaption,
    xlabel/.store in=\boxxlabel,
    ylabel/.store in=\boxylabel,
    zlabel/.store in=\boxzlabel,
}

\tikzset{Box/.pic={
    \pgfkeys{/boxblock/.cd, default, #1}
    \pgfmathsetmacro{\x}{\boxwidth*\boxscale}
    \pgfmathsetmacro{\y}{\boxheight*\boxscale}
    \pgfmathsetmacro{\z}{\boxdepth*\boxscale}

    % eight corners (front face at z=+\z/2)
    \coordinate (a) at (0  , \y/2, \z/2);
    \coordinate (b) at (0  ,-\y/2, \z/2);
    \coordinate (c) at (\x ,-\y/2, \z/2);
    \coordinate (d) at (\x , \y/2, \z/2);
    \coordinate (e) at (\x , \y/2,-\z/2);
    \coordinate (f) at (\x ,-\y/2,-\z/2);
    \coordinate (g) at (0  ,-\y/2,-\z/2);
    \coordinate (h) at (0  , \y/2,-\z/2);

    \draw[draw=black!60, fill=\boxfill, fill opacity=\boxopacity, line join=round]
        (d) -- (a) -- (b) -- (c) -- cycle   % front
        (d) -- (a) -- (h) -- (e) -- cycle   % top
        (d) -- (e) -- (f) -- (c) -- cycle;  % right
    % face shading (light from upper-left): top a touch, right more
    \fill[black, opacity=0.10] (d) -- (a) -- (h) -- (e) -- cycle;
    \fill[black, opacity=0.22] (d) -- (e) -- (f) -- (c) -- cycle;
    \draw[draw=black!35, densely dashed, opacity=0.6]
        (f) -- (g) (b) -- (g) (h) -- (g);

    % labels
    \path (b) -- (c) node[midway, below=1pt, font=\fntsm] {\boxxlabel};
    \path (a) -- (b) node[midway, left=1pt,  font=\fntsm] {\boxylabel};
    \path (c) -- (f) node[midway, below right, font=\fntsm, sloped] {\boxzlabel};

    % anchors for connections / layout
    \coordinate (\boxname-west)      at (0   , 0     , 0);
    \coordinate (\boxname-east)      at (\x  , 0     , 0);
    \coordinate (\boxname-north)     at (\x/2, \y/2  , 0);
    \coordinate (\boxname-south)     at (\x/2,-\y/2  , 0);
    \coordinate (\boxname-anchor)    at (\x/2, 0     , 0);
    \coordinate (\boxname-northeast) at (\x  , \y/2  , \z/2);
    \coordinate (\boxname-northwest) at (0   , \y/2  , \z/2);
    \coordinate (\boxname-southeast) at (\x  ,-\y/2  , \z/2);
    \coordinate (\boxname-southwest) at (0   ,-\y/2  , \z/2);
    \coordinate (\boxname-near)      at (\x/2, 0     , \z/2);
    \coordinate (\boxname-neareast)  at (\x  , 0     , \z/2);
    \coordinate (\boxname-nearwest)  at (0   , 0     , \z/2);
}}
